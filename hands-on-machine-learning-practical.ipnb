    {
      "cell_type": "code",
      "source": [
        "y_pred=model.predict(x)"
      ],
      "metadata": {
        "id": "zahpJnTRC7aU"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "rsquare=r2_score(y,y_pred)"
      ],
      "metadata": {
        "id": "qFBe8FVvDT5p"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "mae=mean_absolute_error(y,y_pred)"
      ],
      "metadata": {
        "id": "LSKVKywkDdGp"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "intercept_value = model.intercept_\n",
        "slope_value = model.coef_[0]"
      ],
      "metadata": {
        "id": "gGlr9dIQD3AL"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "print(f\"Intercept: {intercept_value}\")\n",
        "print(f\"Slope: {slope_value}\")\n",
        "print(f\"R-squared (r2): {rsquare}\")\n",
        "print(f\"Mean Absolute Error (MAE): {mae}\")\n",
        "\n",
        "# Plot the results\n",
        "plt.scatter(x, y, color='blue', label='Actual Marks')\n",
        "plt.plot(x, y_pred, color='red', label='Line of Best Fit')\n",
        "plt.xlabel('Hours Studied Before Exam')\n",
        "plt.ylabel('Marks')\n",
        "plt.title('Linear Regression')\n",
        "plt.legend()\n",
        "plt.show()"
